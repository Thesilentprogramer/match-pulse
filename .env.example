# Optional. With neither key set, Match Pulse uses the deterministic desk voice
# and the full demo still runs.

# Direct OpenAI. The key stays on the server. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or route the same calls through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
MATCH_PULSE_MODEL=openai/gpt-4o-mini

# Optional speech if espeak-ng is not installed. The key stays on the server.
# NVIDIA's OpenAI-compatible endpoint, used only by the shot-prompt director.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Reserved for a future Hugging Face video clip. The port returns null until a model is attached.
HF_TOKEN=
